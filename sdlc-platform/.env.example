DATABASE_URL=postgresql+asyncpg://sdlc:sdlc@localhost:5432/sdlc
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
MAX_NODE_VISITS=100

OTLP_ENDPOINT=

# Secrets are added as later phases introduce them. Do not invent values here.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4/
GLM_CHAT_MODEL=glm-4.7-flash
GLM_EMBED_MODEL=embedding-3
PRICING_REGISTRY_PATH=configs/pricing/registry.yaml
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_S=30

# Phase 03 — local working tree for Repository Intelligence (not a git SHA / remote).
RI_REPO_ROOT=
# Optional Zoekt shard directory. Empty = ~/.cache/sdlc-platform/zoekt/<repo-hash>/
RI_ZOEKT_INDEX_DIR=
